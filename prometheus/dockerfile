ARG VERSION=v3.5.4

FROM prom/prometheus:${VERSION}

# Copy the prom.yml configuration file to the container
COPY prom.yml /etc/prometheus/prom.yml

# Railway volumes are mounted as root; run as root so Prometheus can write to /prometheus
USER root

# Command to run Prometheus
CMD ["--config.file=/etc/prometheus/prom.yml", "--storage.tsdb.path=/prometheus", "--web.enable-otlp-receiver"]